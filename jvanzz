-- ========== ESP + NAMA ==========
local espFolder = Instance.new("Folder")
espFolder.Name = "STG_ESP"
espFolder.Parent = game:GetService("CoreGui")

local function createESP(part, color, name)
    if not part then return end
    
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.5
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0, 200, 0, 30)
    bill.Adornee = part
    bill.AlwaysOnTop = true
    bill.Parent = espFolder
    
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = name or "?"
    txt.TextColor3 = color
    txt.TextSize = 14
    txt.Font = Enum.Font.GothamBold
    txt.TextStrokeTransparency = 0.3
    txt.Parent = bill
end

local function clearESP()
    for _, v in pairs(espFolder:GetChildren()) do
        v:Destroy()
    end
end

-- ESP Loop
spawn(function()
    while wait(0.5) do
        if not s.esp then 
            clearESP()
        else
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name and v.Name:lower():find("marsh") and v:IsA("BasePart") then
                    if not v:FindFirstChildWhichIsA("Highlight") then
                        createESP(v, Color3.fromRGB(0,255,0), "🍬")
                    end
                end
            end
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name and (v.Name:lower():find("stove") or v.Name:lower():find("kompor")) and v:IsA("BasePart") then
                    if not v:FindFirstChildWhichIsA("Highlight") then
                        createESP(v, Color3.fromRGB(255,200,0), "🍳")
                    end
                end
            end
            for _, pl in pairs(game.Players:GetPlayers()) do
                if pl ~= p and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
                    local root = pl.Character.HumanoidRootPart
                    if not root:FindFirstChildWhichIsA("Highlight") then
                        createESP(root, Color3.fromRGB(255,50,50), pl.Name)
                    end
                end
            end
        end
    end
end)

-- ========== FARM ==========
spawn(function()
    while wait(1.2) do
        if not s.farm then continue end
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name and v.Name:lower():find("marsh") and v:IsA("BasePart") then
                r.CFrame = CFrame.new(v.Position)
                wait(0.1)
                pcall(function() 
                    firetouchinterest(r, v, 0)
                    wait(0.05)
                    firetouchinterest(r, v, 1)
                end)
                inv.raw = inv.raw + 1
                break
            end
        end
    end
end)

-- ========== COOK ==========
spawn(function()
    while wait(2) do
        if not s.cook or inv.raw < 1 then continue end
        local stove = nil
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name and (v.Name:lower():find("stove") or v.Name:lower():find("kompor")) and v:IsA("BasePart") then
                stove = v
                break
            end
        end
        if stove then
            r.CFrame = CFrame.new(stove.Position.X, stove.Position.Y - 3.5, stove.Position.Z)
            wait(0.5)
            inv.raw = inv.raw - 1
            inv.cooked = inv.cooked + 1
        end
    end
end)

-- ========== SELL ==========
spawn(function()
    while wait(2) do
        if not s.sell or inv.cooked < 1 then continue end
        local seller = workspace:FindFirstChild("Seller") or workspace:FindFirstChild("Vendor")
        if seller and seller.PrimaryPart then
            r.CFrame = CFrame.new(seller.PrimaryPart.Position + Vector3.new(0,0,3))
            wait(0.5)
        end
        inv.cooked = inv.cooked - 1
    end
end)

